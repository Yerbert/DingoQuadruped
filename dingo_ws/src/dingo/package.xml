<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dingo</name>
  <version>0.0.0</version>
  <description>Main Dingo driver node and top-level launch files</description>
  <maintainer email="alex@todo.todo">alex</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>dingo_msgs</depend>
  <depend>dingo_control</depend>
  <depend>dingo_input_interfacing</depend>
  <depend>dingo_servo_interfacing</depend>
  <depend>dingo_peripheral_interfacing</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>dingo_gazebo</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
