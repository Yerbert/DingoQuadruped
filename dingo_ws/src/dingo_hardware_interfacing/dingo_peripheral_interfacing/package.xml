<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dingo_peripheral_interfacing</name>
  <version>0.0.0</version>
  <description>IMU, LCD display and battery monitoring for Dingo</description>
  <maintainer email="alex@todo.todo">alex</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <depend>std_msgs</depend>
  <depend>dingo_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
